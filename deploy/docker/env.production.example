APP_NAME=PixelPilot
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://pixelpilot.example.com
# Host name Traefik routes to this stack.
APP_HOST=pixelpilot.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pixelpilot
DB_USERNAME=pixelpilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# Password-reset emails are written to the log unless SMTP is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pixelpilot.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The Pixelforge key created for THIS deployment, and its signing secret.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_TIMEOUT=30

PIXELPILOT_STORE_IMAGES=false
